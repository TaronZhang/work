FROM chaitin/agent-compose-guest:v2608.4.0

ARG HTTP_PROXY
ARG HTTPS_PROXY
ENV HTTP_PROXY=${HTTP_PROXY}
ENV HTTPS_PROXY=${HTTPS_PROXY}

RUN echo 'Acquire::http::Proxy "http://proxy.in.chaitin.net:8123";' > /etc/apt/apt.conf.d/01proxy \
    && echo 'Acquire::https::Proxy "http://proxy.in.chaitin.net:8123";' >> /etc/apt/apt.conf.d/01proxy \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv \
    libxml2-dev libxslt1-dev libjpeg-dev libpng-dev \
    libmagic1 libfreetype6 \
    antiword catdoc \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /tmp/requirements.txt
RUN pip3 install --no-cache-dir --break-system-packages -r /tmp/requirements.txt

COPY . /app/bid-checker
WORKDIR /app/bid-checker

RUN pip3 install --break-system-packages -e .

RUN chmod +x /app/bid-checker/cli/main.py

ENV PYTHONPATH=/app/bid-checker
ENV PYTHONUNBUFFERED=1
