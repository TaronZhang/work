# bid-checker 环境配置 (agent-compose 模式)

# LLM 配置 (公司 AI Gateway)
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://ai-api-gateway.app.baizhi.cloud/api/openai
OPENAI_MODEL=gpt-5.6-sol

# Flask Web 模式 (双模式共存时使用)
FLASK_DEBUG=0
HOST=0.0.0.0
PORT=29661
MAX_CONTENT_LENGTH_MB=500

# 大文件自动分片
AUTO_SPLIT_THRESHOLD_MB=10
AUTO_SPLIT_MAX_CHARS=100000

# 上传目录
UPLOAD_FOLDER=/tmp/docdiff_uploads
