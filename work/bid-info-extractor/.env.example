# LLM Configuration (OpenAI-compatible, default DeepSeek)
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-deepseek-api-key
LLM_MODEL=deepseek-chat

# Feishu Configuration
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=your-feishu-app-secret

# Security
ENCRYPTION_MASTER_PASSWORD=your-random-master-password-40-chars-min
API_AUTH_TOKEN=auto-generated-on-first-run

# System Paths
UPLOAD_DIR=data/uploads
EXPORT_DIR=data/exports
DATABASE_URL=sqlite+aiosqlite:///data/bid_info_extractor.db
MAX_UPLOAD_SIZE_MB=500
CORS_ORIGINS=*
