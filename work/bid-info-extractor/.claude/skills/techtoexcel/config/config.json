{
  "name": "techtoexcel",
  "version": "1.3.0",
  "description": "从招标文件(.docx/.doc)中提取指定章节内容，自动生成技术偏离表Excel",
  "entry": "scripts/main.py",
  "inputs": [
    {
      "name": "source_docx",
      "type": "path",
      "required": true,
      "description": "招标文件路径（.docx或.doc格式）"
    },
    {
      "name": "chapter",
      "type": "string",
      "required": true,
      "description": "目标章节名，如'第三章 采购需求'或'六、招标内容与要求'"
    },
    {
      "name": "output_xlsx",
      "type": "path",
      "required": true,
      "description": "输出Excel(.xlsx)路径"
    }
  ],
  "permissions": {
    "allow": [
      "Bash(python3 *)",
      "Bash(python *)",
      "Bash(pip install *)",
      "Read(*)",
      "Write(*.xlsx)",
      "Write(*.py)",
      "Edit(*.py)"
    ]
  },
  "dependencies": {
    "required": ["python-docx", "openpyxl"],
    "optional": ["pywin32"],
    "note": "pywin32用于.doc格式转换，如仅处理.docx则可不安装"
  },
  "env": {},
  "timeout": 120000
}
